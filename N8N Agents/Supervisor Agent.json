    {
      "parameters": {
        "jsCode": "try {\n\n  function cleanJson(data) {\n\n    if (Array.isArray(data)) {\n      return data\n        .map(cleanJson)\n        .filter(item =>\n          !(Array.isArray(item) && item.length === 0)\n        );\n    }\n\n    if (data && typeof data === \"object\") {\n\n      if (\n        \"value\" in data &&\n        Object.keys(data).every(\n          key => [\"value\", \"evidence\"].includes(key)\n        )\n      ) {\n        return cleanJson(data.value);\n      }\n\n      const result = {};\n\n      for (const [key, value] of Object.entries(data)) {\n\n        if (key === \"evidence\") continue;\n\n        const cleaned = cleanJson(value);\n\n        if (Array.isArray(cleaned) && cleaned.length === 0)\n          continue;\n\n        result[key] = cleaned;\n      }\n\n      return result;\n    }\n\n    return data;\n  }\n\n  const cleaned = cleanJson($input.first().json);\n\n  console.log(\"Cleaned JSON:\");\n  console.log(cleaned);\n\n  return [{\n    json: cleaned\n  }];\n\n} catch (e) {\n\n  console.error(\"Clean JSON failed:\", e);\n\n  return [{\n    json: {\n      status: \"error\",\n      stage: \"Clean JSON Response\",\n      error: e.message\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
